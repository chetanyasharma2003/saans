FROM node:24-alpine

WORKDIR /app

# Copy package files
COPY saans-api/package*.json ./

# Install dependencies
RUN npm ci

# Copy source
COPY saans-api/src ./src
COPY saans-api/prisma ./prisma
COPY saans-api/tsconfig.json ./

# Build
RUN npm run build

# Generate Prisma
RUN npx prisma generate

EXPOSE 3000
CMD ["npm", "start"]
