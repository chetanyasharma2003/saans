// Types
interface Therapist {
  id: string;
  name: string;
  specialty: string[];
  rating: number;
  reviews: number;
  price: number;
  languages: string[];
  availability: string[];
  image: string;
  bio: string;
  experience: number;
  certifications: string[];
  reviews_list: Review[];
  city?: string;
  state?: string;
  cityMatch?: 'same-city' | 'nearby' | null;
}

interface Review {
  id: string;
  author: string;
  rating: number;
  text: string;
  date: string;
}

