{
  "buildCommand": "VITE_API_URL=https://saans-backend-ti8p.onrender.com npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "env": {
    "VITE_API_URL": "https://saans-backend-ti8p.onrender.com",
    "VITE_SOCKET_URL": "https://saans-backend-ti8p.onrender.com",
    "VITE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
