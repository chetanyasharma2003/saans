{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "env": [
    {
      "key": "VITE_API_URL",
      "value": "https://saans-backend-tt8p.onrender.com"
    },
    {
      "key": "VITE_SOCKET_URL",
      "value": "https://saans-backend-tt8p.onrender.com"
    },
    {
      "key": "VITE_ENV",
      "value": "production"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
