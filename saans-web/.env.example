# API
VITE_API_URL="http://localhost:3000"
VITE_API_TIMEOUT=10000

# SOCKET.IO
VITE_SOCKET_URL="http://localhost:3000"
VITE_SOCKET_RECONNECTION_ATTEMPTS=5
VITE_SOCKET_RECONNECTION_DELAY=1000

# STRIPE
VITE_STRIPE_PUBLIC_KEY="pk_test_..."

# GOOGLE ANALYTICS
VITE_GA_ID=""

# MONITORING & OBSERVABILITY
# Sentry Error Tracking & Performance Monitoring (React)
VITE_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# Disabled in development by default, enable in production for monitoring
# Set tracesSampleRate (0.0-1.0): 0.1 = 10% of transactions, higher % in dev for debugging
# Set replaysSessionSampleRate (0.0-1.0): 0.1 = 10% of sessions, record user interactions
# Set replaysOnErrorSampleRate (0.0-1.0): 1.0 = always capture replays on errors

# ENV
VITE_ENV="development"
VITE_APP_VERSION="0.1.0"

# FEATURES
VITE_ENABLE_AI_COUNSELOR=true
VITE_ENABLE_THERAPIST_MARKETPLACE=true
VITE_ENABLE_CRISIS_HOTLINE=true
