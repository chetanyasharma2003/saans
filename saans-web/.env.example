# ============================================
# SAANS Web Frontend - Environment Configuration
# ============================================
# Copy this file to .env.local and update with your actual URLs

# ============================================
# API CONFIGURATION
# ============================================
VITE_API_URL=http://localhost:3001
VITE_API_TIMEOUT=30000

# ============================================
# PAYMENT GATEWAYS
# ============================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_here

# ============================================
# OAUTH SOCIAL LOGIN
# ============================================
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=com.saans.app

# ============================================
# VIDEO CALLING (Agora)
# ============================================
VITE_AGORA_APP_ID=your_agora_app_id_here

# ============================================
# FIREBASE (Push Notifications)
# ============================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ============================================
# ANALYTICS
# ============================================
VITE_SENTRY_DSN=https://key@sentry.io/project-id
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================
# APP CONFIGURATION
# ============================================
VITE_APP_NAME=SAANS
VITE_APP_VERSION=1.0.0
VITE_APP_URL=https://saans.com

# ============================================
# FEATURE FLAGS
# ============================================
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_COMMUNITY=true
VITE_ENABLE_ADMIN_DASHBOARD=true
VITE_ENABLE_MOBILE_APP=true

# ============================================
# DEVELOPMENT
# ============================================
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info
