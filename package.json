{
  "name": "saans",
  "version": "2.0.0",
  "description": "SAANS - Mental Health Platform (Express + React)",
  "engines": {
    "node": "18+"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6"
  },
  "scripts": {
    "build": "cd saans-web && npm ci --legacy-peer-deps --production=false && npm run build && cd ../server && npm ci --legacy-peer-deps",
    "start": "cd server && npm start",
    "dev": "concurrently \"cd server && npm run dev\" \"cd saans-web && npm run dev\"",
    "lint": "eslint 'saans-web/src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'saans-web/src/**/*.{ts,tsx,json}'"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.17.0",
    "cors": "^2.8.6",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.6.2"
  }
}
