{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "dist",
  "nodeVersion": "18.x",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/dist/index.js" }
  ],
  "env": [
    {
      "key": "DATABASE_URL",
      "target": ["production"],
      "configurable": true
    },
    {
      "key": "JWT_SECRET",
      "target": ["production"],
      "configurable": true
    },
    {
      "key": "CORS_ORIGIN",
      "value": "https://saans-web.vercel.app",
      "target": ["production"]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": true,
      "master": true
    }
  }
}
