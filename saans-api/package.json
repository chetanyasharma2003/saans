{
  "name": "saans-api",
  "version": "0.1.0",
  "description": "SAANS Mental Health Platform - Backend API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "npx prisma migrate deploy --skip-generate || true && node dist/index.js",
    "lint": "eslint 'src/**/*.{ts,js}' --fix",
    "format": "prettier --write 'src/**/*.{ts,js,json}'",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed": "prisma db seed",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "node --loader ts-node/esm prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@sentry/node": "^7.100.0",
    "@sentry/tracing": "^7.100.0",
    "axios": "^1.3.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "joi": "^17.9.2",
    "js-yaml": "^5.2.3",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.3",
    "razorpay": "^2.9.8",
    "redis": "^4.6.5",
    "socket.io": "^4.5.4",
    "speakeasy": "^2.0.0",
    "stripe": "^11.16.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@prisma/client": "^4.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^18.19.130",
    "@types/qrcode": "^1.5.2",
    "@types/speakeasy": "^2.0.8",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "jest": "^30.4.2",
    "prettier": "^2.8.8",
    "prisma": "^4.13.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "tsx": "^3.12.7",
    "typescript": "^5.0.4"
  }
}
