DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/saans_dev"
# DATABASE
DATABASE_URL_SHADOW="postgresql://saans_user:saans_password@localhost:5432/saans_shadow"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# REDIS
REDIS_URL="redis://localhost:6379"

# API
API_PORT=3000
API_HOST="0.0.0.0"
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:5173"
CORS_CREDENTIALS="true"

# GROQ AI (FREE!)
GROQ_API_KEY="gsk_YOUR_FREE_KEY_HERE"
# Get free key: https://console.groq.com

# STRIPE (Payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# RAZORPAY (India Payments)
RAZORPAY_KEY_ID="rzp_test_1234567890"
RAZORPAY_KEY_SECRET="test_secret_key_for_testing_purposes"

# TWILIO (SMS)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1234567890"

# SENDGRID (Email)
SENDGRID_API_KEY="SG..."
SENDGRID_FROM_EMAIL="noreply@saans.app"

# AWS S3 (File Storage)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_S3_BUCKET="saans-files"

# MONITORING
SENTRY_DSN="https://..."
LOG_LEVEL="info"

# FRONTEND URL
FRONTEND_URL="http://localhost:5173"

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# SESSION
SESSION_TIMEOUT_MS=1800000
