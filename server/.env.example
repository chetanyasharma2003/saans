# SAANS Backend Environment Variables
# Copy this file to .env and fill in actual values
# NEVER commit .env to git!

# Server Configuration
PORT=3001
NODE_ENV=production

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
SESSION_SECRET=your-super-secret-session-key-min-32-characters
JWT_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=https://your-vercel-domain.com

# Database (PostgreSQL via Neon)
DATABASE_URL=postgresql://user:password@neon.tech/saans?sslmode=require

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Agora Video Calling
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# SendGrid Email Service
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# Groq AI Service (Optional)
GROQ_API_KEY=gsk_xxxxxxxxxxxxx

# Enable Demo Data (Only in development)
# ENABLE_DEMO_DATA=false (never use in production)
