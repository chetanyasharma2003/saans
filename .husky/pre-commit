#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Pre-commit: Running code quality checks..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

# Check for JavaScript/TypeScript files
JS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' | grep -v node_modules)

if [ -z "$JS_FILES" ]; then
  echo "✅ No JavaScript/TypeScript files to check"
  exit 0
fi

# STEP 1: Format code with Prettier
echo "✨ Formatting code with Prettier..."
for file in $JS_FILES; do
  if [ -f "$file" ]; then
    npx prettier --write "$file" 2>/dev/null || true
  fi
done

# STEP 2: Run ESLint
echo "🔍 Running ESLint..."
npx eslint --fix $JS_FILES 2>/dev/null || {
  echo "❌ ESLint errors found (attempting auto-fix)..."
  npx eslint --fix $JS_FILES || true
}

# STEP 3: Type checking
echo "📘 Checking TypeScript types..."
npx tsc --noEmit 2>/dev/null || {
  echo "⚠️ TypeScript errors found (non-blocking)"
  # Don't exit, let commit proceed but with warning
}

# Re-stage fixed files
echo "📤 Re-staging fixed files..."
git add $JS_FILES

echo "✅ Pre-commit checks complete!"
echo "Files formatted and checked before commit"
exit 0
